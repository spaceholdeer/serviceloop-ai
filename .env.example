# API 密钥只能配置在仓库根目录的 .env 文件中，不读取系统环境变量。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
SERVICELOOP_RAG_EMBED_MODEL=qwen3.7-text-embedding
SERVICELOOP_RAG_EMBED_DIM=1024
SERVICELOOP_RAG_RERANK_MODEL=BAAI/bge-reranker-base

# MySQL 8。简历演示项目只保留一个连接配置。
DATABASE_URL=mysql+pymysql://serviceloop:serviceloop_dev@127.0.0.1:3306/serviceloop?charset=utf8mb4
